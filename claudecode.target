<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<?pde version="3.8"?>
<target name="Claude Code for Eclipse Target Platform" sequenceNumber="1">
	<locations>
		<location includeMode="planner" includeAllPlatforms="false" includeSource="false" includeConfigurePhase="true" type="InstallableUnit">
			<repository location="https://download.eclipse.org/releases/2026-09"/>
			<unit id="org.eclipse.platform.ide" version="0.0.0"/>
			<unit id="org.eclipse.jdt.feature.group" version="0.0.0"/>
			<unit id="org.eclipse.cdt.feature.group" version="0.0.0"/>
			<unit id="org.eclipse.terminal.feature.feature.group" version="0.0.0"/>
		</location>
		<location includeMode="planner" includeAllPlatforms="false" includeSource="false" type="InstallableUnit">
			<!-- pydev.org's own site proxies to a GitHub Releases asset via a
			     cross-domain redirect that Eclipse's p2 transport can't
			     follow (curl -L handles it fine; equinox does not), so this
			     points at PyDev's SourceForge mirror instead, which serves
			     content.jar directly. -->
			<repository location="http://pydev.sourceforge.net/pydev_update_site/13.1.0/"/>
			<unit id="org.python.pydev.feature.feature.group" version="0.0.0"/>
		</location>
	</locations>
</target>
